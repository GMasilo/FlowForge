{
  "kind": "flowforge.configuration-guide",
  "note": "Setup reference, not an import file. Create and install connections in FlowForge, then map their generated IDs. Never store credentials in this file.",
  "liveSteps": [
    "student_sign_in",
    "programme_catalog",
    "application_upload",
    "submit_application",
    "save_application",
    "application_email",
    "admission_status",
    "accept_offer_api",
    "funding_lookup",
    "tuition_payment",
    "payment_plan",
    "registration_clearance",
    "register_modules",
    "lms_provision",
    "campus_calendar",
    "save_appointment",
    "orientation_email",
    "learning_dashboard",
    "tutor_booking",
    "support_record",
    "support_ticket",
    "adviser_handoff",
    "academic_results",
    "assessment_appeal",
    "career_opportunities",
    "career_crm",
    "career_email",
    "graduation_clearance",
    "graduation_rsvp",
    "alumni_preferences",
    "alumni_crm",
    "alumni_welcome",
    "journey_feedback"
  ],
  "connections": [
    {
      "step": "programme_catalog",
      "type": "entity",
      "connection": "FlowForge programmes",
      "purpose": "Read catalogue",
      "configuration": {
        "entityId": "00890c3a-7c06-5b2e-a846-6b29e25e76eb",
        "operation": "list",
        "columnMode": "selected",
        "selectedColumns": [
          "code",
          "name",
          "annual_fee",
          "minimum_score"
        ],
        "outputVariable": "programmes"
      },
      "expectedDemoResponse": [
        {
          "code": "BSC-CS",
          "name": "BSc Computing",
          "faculty": "Science",
          "annual_fee": 52000,
          "minimum_score": 28
        },
        {
          "code": "BCOM",
          "name": "BCom Business",
          "faculty": "Commerce",
          "annual_fee": 46000,
          "minimum_score": 26
        },
        {
          "code": "BA-DES",
          "name": "BA Design",
          "faculty": "Humanities",
          "annual_fee": 48000,
          "minimum_score": 24
        }
      ]
    },
    {
      "step": "submit_application",
      "type": "http",
      "connection": "Student information system HTTP",
      "purpose": "/applications",
      "configuration": {
        "connectionId": "",
        "method": "POST",
        "path": "/applications",
        "body": "{\"student_ref\": \"{{vars.studentRef}}\", \"route\": \"{{vars.application_type}}\", \"programme\": \"{{vars.programme_choice}}\"}",
        "outputVariable": "applicationResult"
      },
      "expectedDemoResponse": {
        "reference": "APP-DEMO-001",
        "status": "received"
      }
    },
    {
      "step": "save_application",
      "type": "entity",
      "connection": "FlowForge applications",
      "purpose": "Persist applications",
      "configuration": {
        "entityId": "1a33563d-7f88-5a23-8f41-bf03698dbb7a",
        "operation": "create",
        "fieldMap": {
          "student_ref": "{{vars.studentRef}}",
          "programme": "{{vars.programme_choice}}",
          "status": "received",
          "consent": "{{vars.consent}}"
        },
        "outputVariable": "save_applicationRecord"
      },
      "expectedDemoResponse": {
        "id": "DEMO-save_application",
        "status": "simulated"
      }
    },
    {
      "step": "application_email",
      "type": "email",
      "connection": "Institution email SMTP",
      "purpose": "Application acknowledgement \u2014 reference {{vars.applicationResult.reference}}",
      "configuration": {
        "connectionId": "",
        "to": "{{vars.studentEmail}}",
        "templateKey": "student_email",
        "subject": "Application acknowledgement \u2014 reference {{vars.applicationResult.reference}}",
        "body": "Student reference {{vars.studentRef}}. Application acknowledgement \u2014 reference {{vars.applicationResult.reference}}"
      },
      "expectedDemoResponse": null
    },
    {
      "step": "admission_status",
      "type": "http",
      "connection": "Student information system HTTP",
      "purpose": "/applications/{{vars.studentRef}}/decision",
      "configuration": {
        "connectionId": "",
        "method": "GET",
        "path": "/applications/{{vars.studentRef}}/decision",
        "body": "",
        "outputVariable": "admissionDecision"
      },
      "expectedDemoResponse": {
        "status": "{{vars.demo_decision}}",
        "offer_ref": "OFFER-DEMO-001"
      }
    },
    {
      "step": "accept_offer_api",
      "type": "http",
      "connection": "Student information system HTTP",
      "purpose": "/offers/{{vars.admissionDecision.offer_ref}}/accept",
      "configuration": {
        "connectionId": "",
        "method": "POST",
        "path": "/offers/{{vars.admissionDecision.offer_ref}}/accept",
        "body": "{\"student_ref\": \"{{vars.studentRef}}\"}",
        "outputVariable": "offerAcceptance"
      },
      "expectedDemoResponse": {
        "status": "accepted_conditionally"
      }
    },
    {
      "step": "funding_lookup",
      "type": "http",
